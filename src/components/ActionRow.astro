---
import { site } from '../config.mjs'
import { ui } from '../lib/ui'

interface Props {
  slug: string
  title: string
  readingMinutes: number
  /** Repo-relative path of the source markdown file. */
  filePath: string
  /** Language of the post this row belongs to; labels follow it. */
  lang?: string
}

const { slug, title, readingMinutes, filePath, lang } = Astro.props
const t = ui(lang)

const url = new URL(`/posts/${slug}/`, Astro.site ?? Astro.url.origin).toString()
const sourceUrl = `https://github.com/${site.github}/blob/main/${filePath}`
const replyUrl = `https://github.com/${site.github}/issues/new?title=${encodeURIComponent(
  `Re: ${title}`
)}&body=${encodeURIComponent(`> ${url}\n\n`)}`

const button =
  'grid size-8 place-items-center rounded-full text-(--color-text) transition-colors hover:bg-(--color-hover)'
---

<div class="-ml-1.5 flex items-center gap-1 text-(--color-text)">
  <a href={replyUrl} target="_blank" rel="noopener noreferrer" class={button} aria-label={t.replyOnGitHub}>
    <svg viewBox="0 0 24 24" fill="none" class="size-[19px]" aria-hidden="true">
      <path
        d="M21 11.5a8.4 8.4 0 0 1-9 8.4 9 9 0 0 1-3.2-.6L3 21l1.8-5a8.2 8.2 0 0 1-.8-3.5 8.4 8.4 0 0 1 9-8.4 8.4 8.4 0 0 1 8 7.4Z"
        stroke="currentColor"
        stroke-width="1.6"
        stroke-linecap="round"
        stroke-linejoin="round"></path>
    </svg>
  </a>

  <button type="button" class={button} data-share={url} aria-label={t.copyLink}>
    <svg viewBox="0 0 24 24" fill="none" class="size-[19px]" aria-hidden="true">
      <path
        d="M10 13.5a3.5 3.5 0 0 0 5 0l3-3a3.5 3.5 0 0 0-5-5l-1 1M14 10.5a3.5 3.5 0 0 0-5 0l-3 3a3.5 3.5 0 0 0 5 5l1-1"
        stroke="currentColor"
        stroke-width="1.6"
        stroke-linecap="round"
        stroke-linejoin="round"></path>
    </svg>
  </button>

  <a href={sourceUrl} target="_blank" rel="noopener noreferrer" class={button} aria-label={t.viewSource}>
    <svg viewBox="0 0 24 24" fill="none" class="size-[19px]" aria-hidden="true">
      <path
        d="M9 18.5c-4 1.2-4-2.1-5.6-2.5M15 21v-3.3a2.9 2.9 0 0 0-.8-2.2c2.7-.3 5.5-1.3 5.5-6a4.7 4.7 0 0 0-1.3-3.2 4.3 4.3 0 0 0-.1-3.2s-1-.3-3.4 1.3a11.6 11.6 0 0 0-6 0C6.5 2.8 5.5 3.1 5.5 3.1a4.3 4.3 0 0 0-.1 3.2A4.7 4.7 0 0 0 4 9.6c0 4.6 2.8 5.6 5.5 6a2.9 2.9 0 0 0-.8 2.1V21"
        stroke="currentColor"
        stroke-width="1.6"
        stroke-linecap="round"
        stroke-linejoin="round"></path>
    </svg>
  </a>

  <span class="ml-1 text-[13px] text-(--color-text-secondary)">
    {t.minRead(readingMinutes)}
  </span>
</div>

{/* Hoisted by Astro: bundled once and shared by every ActionRow on the page. */}
<script>
  document.addEventListener('click', async (event) => {
    const button = (event.target as HTMLElement)?.closest<HTMLElement>('[data-share]')
    if (!button) return

    const url = button.dataset.share
    if (!url) return

    // Prefer the native sheet on mobile, fall back to the clipboard.
    if (navigator.share) {
      try {
        await navigator.share({ url })
        return
      } catch {
        /* Dismissed — fall through to copying. */
      }
    }

    try {
      await navigator.clipboard.writeText(url)
      button.setAttribute('data-copied', '')
      setTimeout(() => button.removeAttribute('data-copied'), 1200)
    } catch {
      /* Clipboard blocked; nothing useful to do. */
    }
  })
</script>

<style>
  [data-share][data-copied] {
    background-color: var(--color-hover);
  }
</style>
