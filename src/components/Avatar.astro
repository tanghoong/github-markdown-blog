---
import { site } from '../config.mjs'
import profile from '../data/github.json'

interface Props {
  size?: number
}

const { size = 36 } = Astro.props
const initial = (site.title ?? '?').trim().charAt(0).toUpperCase()

/**
 * `site.avatar` first, so an explicit choice always wins; otherwise the copy of
 * the GitHub avatar that scripts/github-profile.mjs downloads into public/.
 *
 * Both are same-origin paths. The GitHub CDN URL is deliberately not used, so
 * no page makes a third-party request for a picture — and no reader's IP is
 * handed to GitHub for loading one.
 */
const src = site.avatar ?? (profile as { avatarPath?: string }).avatarPath ?? null
---

{
  src ? (
    <img
      src={src}
      alt={site.title}
      width={size}
      height={size}
      loading="lazy"
      decoding="async"
      class="shrink-0 rounded-full border border-(--color-border) object-cover"
      style={`width:${size}px;height:${size}px`}
    />
  ) : (
    <div
      aria-hidden="true"
      class="grid shrink-0 place-items-center rounded-full border border-(--color-border) bg-(--color-bg-elevated) font-semibold text-(--color-text)"
      style={`width:${size}px;height:${size}px;font-size:${Math.round(size * 0.42)}px`}
    >
      {initial}
    </div>
  )
}
