---
/**
 * Deliberately not a React island. This is the only interactive element on most
 * pages, and pulling in the React runtime for it would cost ~185 KB on every
 * page load. The `@astrojs/react` integration stays configured for genuinely
 * stateful islands later — it emits nothing until something uses it.
 */
---

<button
  type="button"
  id="theme-toggle"
  aria-label="Toggle colour theme"
  class="grid size-9 place-items-center rounded-full text-(--color-text) transition-colors hover:bg-(--color-hover)"
>
  <svg viewBox="0 0 24 24" fill="none" class="size-5" data-icon="moon" aria-hidden="true">
    <path
      d="M20 14.5A8.5 8.5 0 0 1 9.5 4a8.5 8.5 0 1 0 10.5 10.5Z"
      stroke="currentColor"
      stroke-width="1.6"
      stroke-linejoin="round"></path>
  </svg>
  <svg viewBox="0 0 24 24" fill="none" class="size-5" data-icon="sun" aria-hidden="true">
    <circle cx="12" cy="12" r="4.2" stroke="currentColor" stroke-width="1.6"></circle>
    <path
      d="M12 2.5v2M12 19.5v2M2.5 12h2M19.5 12h2M5.1 5.1l1.4 1.4M17.5 17.5l1.4 1.4M18.9 5.1l-1.4 1.4M6.5 17.5l-1.4 1.4"
      stroke="currentColor"
      stroke-width="1.6"
      stroke-linecap="round"></path>
  </svg>
</button>

<script>
  // Delegated from `document` rather than bound to the button.
  //
  // This is a bundled module script, so it executes once per full page load
  // and never again. With view transitions the top bar — and this button with
  // it — is replaced on every client-side navigation, which would leave a
  // listener bound directly to the element pointing at a detached node and the
  // toggle silently dead after the first navigation. `document` survives every
  // swap, so one listener covers all of them.
  document.addEventListener('click', (event) => {
    const target = event.target as HTMLElement | null
    if (!target?.closest('#theme-toggle')) return

    const next = document.documentElement.dataset.theme === 'dark' ? 'light' : 'dark'
    document.documentElement.dataset.theme = next
    try {
      localStorage.setItem('theme', next)
    } catch {
      /* Private mode — the choice just won't persist. */
    }
  })
</script>

<style>
  /* CSS decides which icon is visible, so the button is correct on first paint
     with no hydration and no layout shift. */
  #theme-toggle [data-icon='sun'] {
    display: none;
  }
  :global([data-theme='dark']) #theme-toggle [data-icon='moon'] {
    display: none;
  }
  :global([data-theme='dark']) #theme-toggle [data-icon='sun'] {
    display: block;
  }
</style>
