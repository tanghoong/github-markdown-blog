---
import type { GetStaticPaths } from 'astro'
import Base from '../../layouts/Base.astro'
import PostCard from '../../components/PostCard.astro'
import { getPosts, getTags, type Post } from '../../lib/posts'

export const getStaticPaths = (async () => {
  const posts = await getPosts()
  const tags = await getTags()

  return tags.map(({ name, slug }) => ({
    params: { tag: slug },
    props: { name, posts: posts.filter((post) => post.tags.includes(name)) },
  }))
}) satisfies GetStaticPaths

const { name, posts } = Astro.props as { name: string; posts: Post[] }
---

<Base title={`#${name}`} description={`Posts tagged ${name}.`}>
  <section class="py-6">
    <p class="text-[13px] text-(--color-text-secondary)">Tag</p>
    <h1 class="mt-1 text-[24px] leading-tight font-bold tracking-tight">#{name}</h1>
    <p class="mt-1 text-[15px] text-(--color-text-secondary)">
      {posts.length} post{posts.length === 1 ? '' : 's'}
    </p>
  </section>

  <div class="border-t border-(--color-border)">
    {posts.map((post, index) => <PostCard post={post} last={index === posts.length - 1} />)}
  </div>
</Base>
