---
import Base from '../layouts/Base.astro'
---

<Base title="Not found" description="This page does not exist.">
  <section class="py-24 text-center">
    <h1 class="text-[24px] font-bold tracking-tight">Nothing here</h1>
    <p class="mt-2 text-[15px] text-(--color-text-secondary)">
      This page doesn't exist, or the post was renamed.
    </p>
    <a
      href="/"
      class="mt-6 inline-block rounded-full border border-(--color-border) px-4 py-2 text-[15px] font-medium transition-colors hover:bg-(--color-hover)"
    >
      Back to feed
    </a>
  </section>
</Base>
