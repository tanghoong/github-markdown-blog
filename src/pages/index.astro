---
import Base from '../layouts/Base.astro'
import Avatar from '../components/Avatar.astro'
import PostCard from '../components/PostCard.astro'
import Search from '../components/Search.astro'
import { site } from '../config.mjs'
import { getCategories, getPosts } from '../lib/posts'

const posts = await getPosts()
const categories = await getCategories()
---

<Base>
  <section class="flex items-start justify-between gap-4 py-6">
    <div class="min-w-0">
      <h1 class="text-[24px] leading-tight font-bold tracking-tight">{site.title}</h1>
      <p class="mt-0.5 text-[15px] text-(--color-text-secondary)">{site.handle}</p>
      <p class="mt-3 text-[15px] leading-[1.45]">{site.bio}</p>
      <p class="mt-3 text-[14px] text-(--color-text-secondary)">
        {posts.length} post{posts.length === 1 ? '' : 's'}
      </p>
    </div>
    <Avatar size={72} />
  </section>

  <Search />

  {
    categories.length > 0 && (
      <nav
        class="scrollbar-none -mx-4 flex gap-2 overflow-x-auto px-4 pb-4 sm:-mx-6 sm:px-6"
        aria-label="Categories"
      >
        <span class="rounded-full border border-(--color-text) px-3 py-1 text-[13px] font-medium whitespace-nowrap">
          All
        </span>
        {categories.map((category) => (
          <a
            href={`/tags/${category.name}/`}
            class="rounded-full border border-(--color-border) px-3 py-1 text-[13px] whitespace-nowrap text-(--color-text-secondary) transition-colors hover:border-(--color-text) hover:text-(--color-text)"
          >
            {category.name}
            <span class="ml-1 opacity-60">{category.count}</span>
          </a>
        ))}
      </nav>
    )
  }

  <div class="border-t border-(--color-border)">
    {
      posts.length === 0 ? (
        <p class="py-16 text-center text-[15px] text-(--color-text-secondary)">
          No posts yet. Drop a markdown file into <code>contents/</code> and push.
        </p>
      ) : (
        posts.map((post, index) => (
          <PostCard post={post} last={index === posts.length - 1} />
        ))
      )
    }
  </div>
</Base>

<style>
  .scrollbar-none {
    scrollbar-width: none;
  }
  .scrollbar-none::-webkit-scrollbar {
    display: none;
  }
</style>
