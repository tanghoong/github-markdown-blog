---
import type { GetStaticPaths } from 'astro'
import Base from '../../layouts/Base.astro'
import PostCard from '../../components/PostCard.astro'
import { getCategories, getPosts, type Post } from '../../lib/posts'

export const getStaticPaths = (async () => {
  const posts = await getPosts()
  const categories = await getCategories()

  return categories.map(({ name }) => ({
    params: { category: name },
    props: { posts: posts.filter((post) => post.category === name) },
  }))
}) satisfies GetStaticPaths

const { category } = Astro.params
const { posts } = Astro.props as { posts: Post[] }
---

<Base title={category} description={`Posts filed under ${category}.`}>
  <section class="py-6">
    <p class="text-[13px] text-(--color-text-secondary)">Category</p>
    <h1 class="mt-1 text-[24px] leading-tight font-bold tracking-tight">{category}</h1>
    <p class="mt-1 text-[15px] text-(--color-text-secondary)">
      {posts.length} post{posts.length === 1 ? '' : 's'}
    </p>
  </section>

  <div class="border-t border-(--color-border)">
    {posts.map((post, index) => <PostCard post={post} last={index === posts.length - 1} />)}
  </div>
</Base>
