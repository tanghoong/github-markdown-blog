---
import type { GetStaticPaths, Page } from 'astro'
import Base from '../layouts/Base.astro'
import Avatar from '../components/Avatar.astro'
import PostCard from '../components/PostCard.astro'
import Pagination from '../components/Pagination.astro'
import Search from '../components/Search.astro'
import { site, layout } from '../config.mjs'
import { getCategories, getPosts, getTags, type Post } from '../lib/posts'

export const getStaticPaths = (async ({ paginate }) => {
  const posts = await getPosts()
  // Produces `/` for the first page and `/2/`, `/3/` … thereafter.
  return paginate(posts, { pageSize: layout.postsPerPage })
}) satisfies GetStaticPaths

const { page } = Astro.props as { page: Page<Post> }

const categories = await getCategories()
const tags = await getTags()
const total = page.total
const isFirstPage = page.currentPage === 1

const chip =
  'rounded-full border border-(--color-border) px-3 py-1 text-[13px] whitespace-nowrap text-(--color-text-secondary) transition-colors hover:border-(--color-text) hover:text-(--color-text)'
---

<Base
  title={isFirstPage ? undefined : `Page ${page.currentPage}`}
  description={site.bio}
>
  {
    isFirstPage && (
      <section class="flex items-start justify-between gap-4 py-6">
        <div class="min-w-0">
          <h1 class="text-[24px] leading-tight font-bold tracking-tight">{site.title}</h1>
          <p class="mt-0.5 text-[15px] text-(--color-text-secondary)">{site.handle}</p>
          <p class="mt-3 text-[15px] leading-[1.45]">{site.bio}</p>
          <p class="mt-3 text-[14px] text-(--color-text-secondary)">
            {total} post{total === 1 ? '' : 's'}
          </p>
        </div>
        <Avatar size={72} />
      </section>
    )
  }

  {isFirstPage && <Search />}

  {
    isFirstPage && (categories.length > 0 || tags.length > 0) && (
      <nav
        class="scrollbar-none -mx-4 flex gap-2 overflow-x-auto px-4 pb-4 sm:-mx-6 sm:px-6"
        aria-label="Browse"
      >
        <span class="rounded-full border border-(--color-text) px-3 py-1 text-[13px] font-medium whitespace-nowrap">
          All
        </span>
        {categories.map((category) => (
          <a href={`/categories/${category.slug}/`} class={chip}>
            {category.name}
            <span class="ml-1 opacity-60">{category.count}</span>
          </a>
        ))}
        {tags.map((tag) => (
          <a href={`/tags/${tag.slug}/`} class={chip}>
            #{tag.name}
          </a>
        ))}
      </nav>
    )
  }

  {
    !isFirstPage && (
      <h1 class="py-6 text-[20px] font-bold tracking-tight">Page {page.currentPage}</h1>
    )
  }

  <div class="border-t border-(--color-border)">
    {
      page.data.length === 0 ? (
        <p class="py-16 text-center text-[15px] text-(--color-text-secondary)">
          No posts yet. Drop a markdown file into <code>contents/</code> and push.
        </p>
      ) : (
        page.data.map((post, index) => (
          <PostCard post={post} last={index === page.data.length - 1} />
        ))
      )
    }
  </div>

  <Pagination page={page} />
</Base>

<style>
  .scrollbar-none {
    scrollbar-width: none;
  }
  .scrollbar-none::-webkit-scrollbar {
    display: none;
  }
</style>
